      {
        "__component": "content.text",
        "id": 27,
        "content": [
          {
            "type": "heading",
            "level": 2,
            "children": [
              {
                "text": "OUR COMPANY",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "Temporary Roofing has been established as a trusted sister company to Tower Scaffold + Temporary Roof, bringing over 20 years of combined experience in the scaffolding and access industry. We’ve built a solid reputation for delivering high-quality temporary roofing solutions at fair and competitive prices. Our services are tailored for homeowners, self-builders, and construction companies across Hampshire, Sussex, and Surrey.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "We specialise in designing and installing temporary roofing systems that offer reliable weather protection and site safety throughout your project. Our professional and experienced team provide a complete service from planning to installation, including a pre-tender consultation to understand your project requirements. You’ll receive detailed drawings and safety documentation, ensuring every aspect of your temporary roofing solution meets the highest standards of quality and compliance.",
                "type": "text"
              }
            ]
          }
        ],
        "highlight": false,
