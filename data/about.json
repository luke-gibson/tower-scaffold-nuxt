      {
        "__component": "content.split-content",
        "id": 48,
        "content": [
          {
            "type": "heading",
            "level": 2,
            "children": [
              {
                "text": "AREAS COVERED",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "Large commercial contracts in the Guildford, Basingstoke, Winchester, Brighton, Guildford and Southampton areas focuses our commitment in those geographical locations however we still maintain a large percentage of our workforce in the local areas of Chichester, Portsmouth, Fareham, Havant, Emsworth and Gosport where most of our day-to-day scaffolding installations take place.",
                "type": "text"
              }
            ]
          }
        ],
