          {
            "type": "heading",
            "level": 1,
            "children": [
              {
                "text": "Get in Touch with Tower Scaffold + Temporary Roofs",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "Whether you’re planning a major project or need advice on the right scaffolding solution, we’re here to help. Reach out to our team today, we’ll get back to you as soon as possible.",
                "type": "text"
              }
            ]
          }
