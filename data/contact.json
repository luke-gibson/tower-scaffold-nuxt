      {
        "__component": "content.text",
        "id": 41,
        "content": [
          {
            "type": "heading",
            "level": 2,
            "children": [
              {
                "text": "We’re Here to Support Your Next Project",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "From detailed scaffold designs to emergency site visits, our team is ready to provide professional guidance and practical solutions. No job is too big or too small — and we’re always happy to offer a no-obligation quote.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "You can contact us directly using the details below or fill out our enquiry form and we’ll be in touch.",
                "type": "text"
              }
            ]
          }
        ],
        "highlight": false,
        "spacingTop": true,
        "spacingBottom": true
